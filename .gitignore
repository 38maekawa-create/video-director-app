venv/
__pycache__/
*.pyc
.env
*.egg-info/
.pytest_cache/
output/
data/

# Runtime/generated state for the video director agent.
# Keep operational data local; do not let auto-sync push logs or SQLite transient files.
.data/*.log
.data/*_stdout.log
.data/*_stderr.log
.data/*.db-shm
.data/*.db-wal
.data/audit/
.data/vimeo_match_report.json

# 手元のデータベースは公開しない(アプリは手元のファイルをパスで直接開く。追跡だけ外す)
.data/**/*.db
.data/**/*.db.*
.data/backups/

# Xcode
DerivedData/
build/
xcuserdata/
*.xcuserstate
*.xcworkspace/xcuserdata/
